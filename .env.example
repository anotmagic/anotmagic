# Copy this file to .env.local and fill in real values.
# The /api/contact route uses these to send mail via SMTP (Nodemailer).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Address the enquiry emails are sent FROM (often must match SMTP_USER's domain)
CONTACT_FROM_EMAIL=no-reply@msciences.example
# Address enquiries are sent TO (can be a comma-separated list)
CONTACT_TO_EMAIL=enquiries@msciences.example
